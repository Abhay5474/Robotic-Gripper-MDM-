# Frontend (Vite). These values are PUBLIC (bundled into the page). Never put the LLM key or
# Firebase service-account credentials here.
VITE_API_BASE=/api
# Firebase Web SDK config (public identifiers) - used only for read-only live telemetry + optional sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_TELEMETRY_PATH=gripper_telemetry
