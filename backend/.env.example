# Copy to backend/.env (never commit .env). All secrets stay on the backend.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API access control: none | bearer | firebase ---
AUTH_MODE=none
# API_BEARER_TOKEN=change-me          # required when AUTH_MODE=bearer

# --- LLM: anthropic | openai_compatible | mock ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=                       # openai_compatible: e.g. https://api.openai.com/v1 or a local gateway
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=2

# --- Firebase Realtime Database: firebase | memory (memory = dev only) ---
STORE_BACKEND=firebase
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
# Provide ONE of the following (service-account JSON is a secret):
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
TELEMETRY_PATH=gripper_telemetry
TELEMETRY_STALE_AFTER_S=5

# --- Gripper: DEMO values until the hardware team supplies validated ones ---
GRIPPER_ID=demo-parallel-gripper
GRIPPER_FINGER_COUNT=2
GRIPPER_CONTACT_PAD_MATERIAL=silicone
GRIPPER_MIN_FORCE_N=1.0
GRIPPER_MAX_FORCE_N=40.0
GRIPPER_FORCE_STEP_N=0.5
GRIPPER_MAX_OPENING_MM=120
GRIPPER_LIMITS_SOURCE=demo            # set to hardware_team once validated
LIFT_ACCELERATION_M_S2=2.0
HOLDING_SAFETY_FACTOR=1.5

# --- Calibration policy ---
CALIBRATION_MAX_AGE_DAYS=365          # 0 = never expire
ALLOW_SAFETY_OVERRIDE=false

# --- Hardware command channel: none | rtdb (only after agreeing it with the hardware team) ---
COMMAND_CHANNEL=none
COMMAND_PATH=gripper_commands

# --- Quick local demo without any credentials (development only) ---
# STORE_BACKEND=memory
# LLM_PROVIDER=mock
# SEED_FILE=../samples/firebase_sample_data.json   # preload sample records (memory store only)
